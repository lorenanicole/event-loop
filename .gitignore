# Uv
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.uv/

# Database
data/*.db

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python packaging (regenerated on every editable install)
*.egg-info/

# Node/Frontend
node_modules/
dist/
.next/
out/
build/

# Playwright
.playwright/

# Local database snapshots (see backend/db_safety.py)
backend/data/backups/

# SQLite WAL artifacts. Created by journal_mode=WAL, rewritten constantly, and
# meaningless without the database file they belong to.
*.db-wal
*.db-shm

# Runtime artifacts under backend/data: the scrape lock, its log, and the
# database snapshots taken before destructive migrations. All reproducible,
# none meaningful to anyone else, and the snapshots are 3.4MB each.
backend/data/.scrape.lock
backend/data/*.log
backend/data/*.db.backup
backend/data/*.before_*
