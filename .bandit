# Bandit security configuration.
#
# YAML, not INI. This was written as an INI file with a [bandit] section,
# which is the setup.cfg format - `bandit -c` parses YAML, so every run died
# with "expected '<document start>'" before scanning a line.

exclude_dirs:
  - "/tests/"
  - "/test_"
  - ".venv"
  - "__pycache__"
  - "/node_modules/"

skips:
  # assert_used: pytest is built on assert, and the test tree is excluded
  # above anyway.
  - B101
