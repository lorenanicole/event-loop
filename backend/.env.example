# Copy to .env for local development. On Railway, set these as environment
# variables in the service dashboard (Settings → Variables).

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# SerpAPI — get at serpapi.com (used for live web event fallback)
SERPAPI_KEY=...

# Ticketmaster Discovery API — get at developer.ticketmaster.com
# Required for general Chicago events AND all sports team games
# (Sky, Fire, Stars, Cubs, Sox, Bears, Bulls, Blackhawks)
TICKETMASTER_API_KEY=...

# ── Set automatically by Railway ──────────────────────────────────────────────
# PORT is injected by Railway; don't set it manually in production.
# PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: use SQLite (default below)
# Production (Railway): use the Postgres reference variable
DATABASE_URL=sqlite+aiosqlite:///./data/events.db
# DATABASE_URL=${{Postgres.DATABASE_URL}}   # Railway Postgres

# ── Optional ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Admin key for POST /api/venue-events/refresh (keep this secret)
ADMIN_KEY=change-me-in-production

# API host/port for local runs only
API_HOST=0.0.0.0
API_PORT=8000
