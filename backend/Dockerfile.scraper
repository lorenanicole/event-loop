# ── EventLoop Scraper (Cron) ──────────────────────────────────────────────────
# Python 3.15 + Playwright.
# greenlet 3.5.6 ships cp315 manylinux wheels (released 2026-09-14) so there
# is no longer any 3.15 blocker for SQLAlchemy's sync core.
# Playwright 1.63.0 is py3-none (pure Python) — works on any version.
#
# On Railway: deploy as a Cron service, schedule "0 */6 * * *" (every 6 hours),
# start command: python scripts/additive_scrape.py
# ─────────────────────────────────────────────────────────────────────────────

FROM mcr.microsoft.com/playwright/python:v1.63.0-jammy

WORKDIR /app

# Install uv via pip (Python 3.14 is bundled in the Playwright image)
RUN pip install --no-cache-dir uv==0.12.23

# Copy dependency manifests
COPY pyproject.toml uv.lock ./

# Install third-party dependencies only (skip local package build)
RUN uv sync --frozen --extra parser --extra app --no-dev --no-install-project

# Copy source + README (README is required by pyproject.toml for package build)
COPY src/ ./src/
COPY README.md ./

# Now install the local eventloop package itself
RUN uv sync --frozen --extra parser --extra app --no-dev
COPY scripts/ ./scripts/
COPY data/ ./data/

RUN mkdir -p /data

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    DATABASE_URL=sqlite+aiosqlite:////data/events.db

# Default command — Railway Cron overrides this per-schedule
CMD ["uv", "run", "python", "scripts/additive_scrape.py"]
