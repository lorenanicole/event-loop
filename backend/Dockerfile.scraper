# ── EventLoop Scraper (Cron) ──────────────────────────────────────────────────
# Python 3.15 + Playwright on a standard Python slim base.
#
# We use python:3.15.0rc3-slim (final tag pending Docker Hub) rather than
# Microsoft's playwright/python image, which hard-codes its own Python version
# (currently 3.14) and gives us no way to upgrade independently.
#
# playwright 1.63.0 is py3-none — pure Python, works on any version.
# greenlet 3.5.6 ships cp315 manylinux wheels — no SQLAlchemy blocker on 3.15.
#
# On Railway: deploy as a Cron service, schedule "0 */6 * * *" (every 6 hours),
# start command: python scripts/additive_scrape.py
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.15.0rc3-slim

WORKDIR /app

# Playwright's Chromium runtime dependencies on Debian slim.
# Equivalent to what `playwright install-deps chromium` would install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv==0.12.24

# Copy dependency manifests
COPY pyproject.toml uv.lock ./

# Install third-party dependencies only (skip local package build)
# The scraper only needs the `parser` extra — `app` pulls in uvicorn[standard]
# which requires gcc to build httptools from source (no cp315 wheel yet).
RUN uv sync --frozen --extra parser --no-dev --no-install-project

# Copy source + README
COPY src/ ./src/
COPY README.md ./

# Install the local eventloop package
RUN uv sync --frozen --extra parser --no-dev

COPY scripts/ ./scripts/
COPY data/ ./data/

# Verify scripts were copied — fail fast at build time if missing
RUN test -f /app/scripts/additive_scrape.py || (echo "ERROR: scripts/additive_scrape.py not found in image" && exit 1)

# Install Playwright's Chromium browser binary into the uv venv
RUN uv run playwright install chromium

RUN mkdir -p /data

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    DATABASE_URL=sqlite+aiosqlite:////data/events.db \
    PATH="/app/.venv/bin:$PATH"

# Activate the venv at build time so the CMD python is the right one
# and Railway's start command override doesn't trigger a uv re-sync.
RUN echo "source /app/.venv/bin/activate" >> /etc/profile

# Use venv python directly — avoids uv re-syncing the package on every cron run
CMD ["/app/.venv/bin/python", "/app/scripts/additive_scrape.py"]
